# ========== ITOPS 环境配置示例 ==========
# 复制为 .env 并按真实环境填写；docker compose 会自动读取本文件
# 注意：REQUIRE_SECURE_SECRETS=true 时，必须修改下方三个默认值，否则后端拒绝启动

# ---------- 基础 ----------
APP_NAME=ITOPS 智能运维分析平台
DEBUG=false
# 对外访问基址（用于推送消息中的报告链接）
PUBLIC_BASE_URL=http://localhost:8080
# 跨域允许来源（逗号分隔，* 表示不限制；生产建议填具体前端地址，如 https://itops.example.com）
CORS_ORIGINS=*
# 是否关闭 /docs 在线接口文档（生产建议 true）
ENABLE_DOCS=false

# ---------- 数据库 ----------
# 默认 SQLite 零配置；切换 PostgreSQL 示例：
# DATABASE_URL=postgresql+asyncpg://itops:itops@postgres:5432/itops
DATABASE_URL=sqlite+aiosqlite:////app/data/itops.db

# ---------- 安全 / 登录 ----------
# 生产强校验：true 时若 ADMIN_PASSWORD/JWT_SECRET_KEY/FERNET_KEY 仍为内置默认值则拒绝启动
REQUIRE_SECURE_SECRETS=true
# 单管理员账号（必须改，不能保留为占位符）
ADMIN_USERNAME=admin
# ⚠️ 首次部署必须替换为强密码（>=12 位，含大小写数字与特殊字符），例如 MyStr0ng@P#i4
# 生成命令：python -c "import secrets;print(secrets.token_urlsafe(16))"
ADMIN_PASSWORD=__REPLACE_ME_BEFORE_DEPLOY__
# JWT 签名密钥（必须改，可用: openssl rand -hex 32）
# 生成命令：openssl rand -hex 32
JWT_SECRET_KEY=__REPLACE_ME_BEFORE_DEPLOY__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# 第三方凭据加密密钥（Fernet，32 字节 base64，必须改，可用: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
# 生成命令：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=__REPLACE_ME_BEFORE_DEPLOY__
# Zabbix Webhook 校验 Token（生产强烈建议设置；留空则不校验，任意请求可触发告警入库）
# Zabbix 端在 URL 携带： ?token=... 或 头携带 X-Webhook-Token: ...
ZABBIX_WEBHOOK_TOKEN=

# ---------- 外部调用 ----------
HTTP_TIMEOUT=15

# ---------- 运维工具箱 ----------
# DHCP 租约文件路径（逗号分隔，按顺序尝试，自动识别 ISC dhcpd / dnsmasq 格式）
DHCP_LEASE_FILES=/var/lib/dhcp/dhcpd.leases,/var/lib/dhcpd/dhcpd.leases,/var/lib/misc/dnsmasq.leases

# ---------- 分析默认参数 ----------
ANALYSIS_AUTO_ENABLED=true
ANALYSIS_BEFORE_MINUTES=30
ANALYSIS_AFTER_MINUTES=10
# 分析成功后自动推送通知的渠道（feishu,wecom，留空表示不自动推送）
AUTO_NOTIFY_CHANNELS=
